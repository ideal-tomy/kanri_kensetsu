# Upstash Redis（デプロイ後の投稿・通知の永続化）
# Vercel 本番では必須。未設定時はメモリのみ（再起動で消える）。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 任意: ワーカーが端末から画像ファイルを直接アップロードする場合
# 未設定ならサンプル画像（/images/...）からの選択のみ。
BLOB_READ_WRITE_TOKEN=

# Supabase 接続設定（Phase 2・任意）
# 未設定でもアプリは動く（prototype-store + Redis で稼働）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
